{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Bash(cat .env)",
      "Bash(cat ./.env)",
      "Bash(cat .env.local)",
      "Bash(type .env)",
      "Bash(more .env)",
      "Bash(less .env)",
      "Bash(head .env)",
      "Bash(tail .env)",
      "Bash(Get-Content .env)",
      "Bash(Get-Content ./.env)",
      "PowerShell(Get-Content .env)",
      "PowerShell(Get-Content ./.env)",
      "PowerShell(cat .env)",
      "PowerShell(type .env)",
      "PowerShell(more .env)",
      "Edit(scripts/legacy/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".venv/Scripts/python.exe .claude/hooks/formate.py"
          }
        ]
      }
    ]
  }
}
