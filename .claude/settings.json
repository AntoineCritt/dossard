{
  "permissions": {
    "deny": ["Read(./.env)", "Edit(scripts/legacy/**)"],
    "allow": ["mcp__dossard__list_views"],
"ask": ["mcp__dossard__query_view"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/garde.py"],
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/journal_mcp.py"]
          }
        ]
      },
      {
  "matcher": "mcp__dossard__.*",
  "hooks": [
    {
      "type": "command",
      "command": "python",
      "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/journal_mcp.py"],
      "onFailure": "block"
    }
  ]
}

    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/formate.py"]
          }
        ]
      }
    ]
  }
}
